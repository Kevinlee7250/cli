# ============================================
# 블로그 자동화 시스템 환경 변수 설정
# ============================================
# 이 파일을 복사해서 .env 로 저장 후 값을 입력하세요
# cp .env.example .env

# ---- Anthropic Claude API ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Naver API (https://developers.naver.com) ----
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ---- Google / Blogger API ----
# Google Cloud Console에서 OAuth2 자격증명 생성
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
BLOGGER_BLOG_ID=your_blogger_blog_id

# ---- AdSense ----
# Google AdSense 관리자 페이지 > 광고 > 광고 단위에서 확인
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ---- ImgBB API (Instagram 이미지 업로드용) ----
# https://api.imgbb.com 에서 무료 API 키 발급
IMGBB_API_KEY=your_imgbb_api_key

# ---- Instagram Graph API ----
# Meta Developer Portal에서 앱 생성 후 취득
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# ---- Threads API ----
# Meta Threads API (Instagram과 동일한 앱에서 취득)
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# ---- TikTok API ----
# TikTok Developer Portal에서 앱 생성
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# ---- 스케줄 설정 ----
# Cron 표현식 (기본: 매일 오전 8시)
SCHEDULE_CRON=0 8 * * *

# ---- 콘텐츠 설정 ----
# 블로그 언어 (ko: 한국어, en: 영어)
BLOG_LANGUAGE=ko
# 키워드 수집 국가 (KR: 한국, US: 미국)
TREND_COUNTRY=KR
# 한 번에 생성할 포스트 수 (1-5)
POSTS_PER_RUN=3

# ---- 썸네일 설정 ----
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
THUMBNAIL_OUTPUT_DIR=./output/thumbnails

# ---- 로그 설정 ----
LOG_LEVEL=info
LOG_FILE=./logs/automation.log
