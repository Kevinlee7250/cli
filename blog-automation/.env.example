# Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# Google Blogger API (OAuth 2.0)
# Google Cloud Console에서 발급: https://console.cloud.google.com
BLOGGER_CLIENT_ID="your-client-id.apps.googleusercontent.com"
BLOGGER_CLIENT_SECRET="your-client-secret"
BLOGGER_BLOG_ID="1234567890"       # 블로그 ID (blogger.com 주소에서 확인)
BLOGGER_REFRESH_TOKEN=""           # setup_blogger_auth.py 실행 후 발급

# 블로그 설정
BLOG_LANGUAGE="ko"                 # ko (한국어) or en (영어)
TREND_COUNTRY="KR"                 # KR, US, JP 등
POSTS_PER_RUN="1"                  # 1회 실행 시 발행할 포스트 수
POST_STATUS="live"                 # live (즉시 발행) or draft (임시저장)

# 스케줄 (cron 형식, 분 시 * * *)
SCHEDULE_CRON="0 9 * * *"          # 매일 오전 9시
